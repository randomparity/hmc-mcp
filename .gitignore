# Live integration test results (contains raw API data with internal hostnames/IPs/serials)
test-results*.json
# `_write_results` writes through `tempfile.mkstemp(prefix=f".{name}.", suffix=".tmp")`,
# so a crash between the write and the rename strands the whole document here.
.test-results*.tmp

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.coverage
.coverage.*

# Virtual environments
.venv

# Local HMC credentials
.env

# desloppify local state
.desloppify/
scorecard.png

# local Claude Code settings
.claude/settings.local.json

# More resources
# No trailing slash: a trailing-slash pattern only matches a real directory,
# not a symlink of the same name, so a worktree-linked docs/refs (see
# scripts/link_reference_corpus.py) would show as untracked. No file named
# docs/refs exists, so the widened match is harmless.
docs/refs
AGENTS.local.md
