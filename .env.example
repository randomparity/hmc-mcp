# IBM HMC connection settings for hmc-mcp.
# Copy to .env and fill in. Never commit .env.

HMC_HOST=hmc.example.com
HMC_PORT=12443
HMC_USER=hscroot
HMC_PASSWORD=changeme

# HMCs ship self-signed certs; leave false unless you've installed the CA.
HMC_VERIFY_SSL=false

# Optional: request timeout (seconds), SSH timeout, and audit-log memento string.
# HMC_TIMEOUT=60
# HMC_SSH_TIMEOUT=300
# HMC_AUDIT_MEMENTO=hmc-mcp

# HMC_SCHEMA_VERSION: leave unset for normal operation. Setting this causes
# HTTP 406 on write endpoints (LPAR create, adapter PUT, etc.) on some HMC
# firmware versions. Only useful for debugging GET schema negotiation.
# HMC_SCHEMA_VERSION=
