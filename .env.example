# Copy this file to .env and replace every value for the test environment.
# The values below are fictional samples. Do not use them against a live HMC.
# LIVE_TEST_* values are required by scripts/live_test_runner.py and are read
# only from this local file; exported LIVE_TEST_* variables are ignored.

# Managed system and LPARs used by the live scenarios (non-empty names).
LIVE_TEST_SYSTEM_NAME=example-lt-609-system
LIVE_TEST_LPAR_NAME=example-lt-609-lpar
LIVE_TEST_SCRATCH_LPAR_NAME=example-lt-609-scratch
LIVE_TEST_NETWORK_TEST_LPAR_NAME=example-lt-609-network

# Test account and virtual disk names (non-empty names).
LIVE_TEST_TEST_USER_NAME=example-lt-609-user
LIVE_TEST_VDISK_NAME=example-lt-609-disk
LIVE_TEST_VDISK_VOLUME_GROUP_NAME=example-lt-609-vg

# Scratch LPAR create and modify resource limits in MiB and virtual CPUs.
LIVE_TEST_SCRATCH_CREATE_DESIRED_MEMORY_MIB=1536
LIVE_TEST_SCRATCH_CREATE_MAX_MEMORY_MIB=3072
LIVE_TEST_SCRATCH_CREATE_DESIRED_VCPUS=3
LIVE_TEST_SCRATCH_CREATE_MAX_VCPUS=6
LIVE_TEST_SCRATCH_MODIFY_DESIRED_MEMORY_MIB=2304
LIVE_TEST_SCRATCH_MODIFY_MAX_MEMORY_MIB=4608

# Dry-run provisioning target and fallback VIOS resources.
LIVE_TEST_DRY_RUN_LPAR_NAME=example-lt-609-dry-run
LIVE_TEST_DRY_RUN_STORAGE_NAME=example-lt-609-dry-disk
LIVE_TEST_DRY_RUN_VIOS_SLOT=17
LIVE_TEST_DRY_RUN_VIOS_PARTITION_ID=307
LIVE_TEST_DRY_RUN_MEMORY_MIB=1536

# Live provisioning fallback resources in MiB and virtual CPUs.
LIVE_TEST_PROVISION_MIN_MEMORY_MIB=1536
LIVE_TEST_PROVISION_DESIRED_MEMORY_MIB=3072
LIVE_TEST_PROVISION_MAX_MEMORY_MIB=6144
LIVE_TEST_PROVISION_DESIRED_VCPUS=3
LIVE_TEST_PROVISION_MAX_VCPUS=6

# Comma-separated LPAR names that ST20 must never mutate.
LIVE_TEST_PROTECTED_LPAR_NAMES=example-lt-609-protected-a,example-lt-609-protected-b

# SR-IOV adapter, physical port, logical port, capacity percentage, and profile.
LIVE_TEST_SRIOV_ADAPTER_ID=17
LIVE_TEST_SRIOV_PHYSICAL_PORT_ID=9
LIVE_TEST_SRIOV_LOGICAL_PORT_ID=917003
LIVE_TEST_SRIOV_CAPACITY_PERCENT=7.5
LIVE_TEST_SRIOV_PROFILE_NAME=example-lt-609-profile

# Virtual-media ISO path, HMC media names, HTTP listener, and HMC-visible host.
LIVE_TEST_ISO_PATH=/srv/example-lt-609/example-lt-609.iso
LIVE_TEST_ISO_MEDIA_NAME=example-lt-609.iso
LIVE_TEST_ISO_HTTP_MEDIA_NAME=example-lt-609-http.iso
LIVE_TEST_ISO_BIND_HOST=0.0.0.0
LIVE_TEST_ISO_ADVERTISED_HOST=iso.example.test
LIVE_TEST_ISO_HTTP_PORT=18090
LIVE_TEST_VMEDIA_REPOSITORY_SIZE_MIB=6144
LIVE_TEST_VMEDIA_SHORT_REPOSITORY_SIZE_MIB=1536

# Placement probe memory in MiB and inclusive VLAN range for a temporary network.
LIVE_TEST_PLACEMENT_MEMORY_MIB=3072
LIVE_TEST_VLAN_RANGE_START=3100
LIVE_TEST_VLAN_RANGE_END=3199
